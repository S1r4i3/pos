# Copy this file to ".env.local" and fill in the values from
# Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_) OR the legacy "anon" key.
# Safe to use in the browser — database security rules protect the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_) OR the legacy "service_role" key.
# SERVER ONLY. Never share it, never prefix it with NEXT_PUBLIC_.
# Not needed until Phase 7 (staff logins), but you can add it now.
SUPABASE_SECRET_KEY=

# The address of your app (used in sign-up / password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
